# ═══════════════════════════════════════════════════════════════════════════════
# Environment Variables Configuration
# Copy this file to .env and adjust values for your environment
# ═══════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
# Service Ports
# ─────────────────────────────────────────────────────────────────────────────
NGINX_PORT=80
NEXTJS_PORT=3000
ESTIMATOR_PORT=8001
MARKET_PORT=8002
ML_SERVICE_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379

# ─────────────────────────────────────────────────────────────────────────────
# PostgreSQL Configuration
# ─────────────────────────────────────────────────────────────────────────────
POSTGRES_USER=portal
POSTGRES_PASSWORD=portal_secret
POSTGRES_DB=portal_db

# ─────────────────────────────────────────────────────────────────────────────
# Next.js Frontend Configuration
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV=production
NEXT_PUBLIC_ESTIMATOR_API_URL=http://localhost/api/v1/estimator
NEXT_PUBLIC_MARKET_API_URL=http://localhost/api/v1/market

# ─────────────────────────────────────────────────────────────────────────────
# Estimator Backend (FastAPI) Configuration
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://portal:portal_secret@postgres:5432/housing
ML_SERVICE_URL=http://housing-price-api:8000
UVICORN_HOST=0.0.0.0
UVICORN_PORT=8001

# ─────────────────────────────────────────────────────────────────────────────
# Market Backend (Spring Boot) Configuration
# ─────────────────────────────────────────────────────────────────────────────
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/housing
SPRING_DATASOURCE_USERNAME=portal
SPRING_DATASOURCE_PASSWORD=portal_secret
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379
SERVER_PORT=8002

# ─────────────────────────────────────────────────────────────────────────────
# Cache Configuration
# ─────────────────────────────────────────────────────────────────────────────
CACHE_TTL_SECONDS=300
CACHE_MAX_MEMORY=256mb

# ─────────────────────────────────────────────────────────────────────────────
# ML Service Configuration
# ─────────────────────────────────────────────────────────────────────────────
ML_SERVICE_TIMEOUT_SECONDS=5
ML_SERVICE_RETRY_MAX_ATTEMPTS=3
ML_SERVICE_RETRY_INITIAL_DELAY_MS=1000
ML_SERVICE_RETRY_MULTIPLIER=2

# ─────────────────────────────────────────────────────────────────────────────
# Housing Price API (ML Service) Documentation
# ─────────────────────────────────────────────────────────────────────────────
# Controls whether Swagger/ReDoc documentation endpoints are accessible.
# Set to "false" in production to disable API documentation exposure.
ENABLE_DOCS=true
